<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>biguasim_sensor_check</name>
  <version>0.1.0</version>
  <description>
    Diagnostic node that subscribes to BiguaSim's sensor topics, measures
    each one's arrival rate, and prints a status table (OK / LOW / STALE /
    SILENT). Use it to verify the BiguaSim &lt;-&gt; ROS 2 connection.
  </description>

  <maintainer email="marckquiroz8@gmail.com">biguauser</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rosidl_runtime_py</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>biguasim_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
