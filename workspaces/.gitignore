# One .gitignore for everything under workspaces/.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ROS 2 / colcon
build/
install/
log/

# Rosbags (large, not versioned)
*.bag
*.db3
*.mcap

# BiguaSim upstream ROS 2 packages, if you ever symlink them into a
# workspace src/ (BiguaSim itself lives at <repo>/biguasim, not here)
*/src/biguasim_upstream

# OS / editor / transfer cruft
*Zone.Identifier
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/
